{
  "name": "@extension/vite-config",
  "version": "0.0.0",
  "description": "chrome extension - vite base configuration",
  "type": "module",
  "private": true,
  "sideEffects": true,
  "exports": {
    "./build-content-script": {
      "types": "./lib/build-content-script.ts",
      "default": "./dist/lib/build-content-script.js"
    },
    "./with-page-config": {
      "types": "./lib/with-page-config.ts",
      "default": "./dist/lib/with-page-config.js"
    },
    "./watch-option": {
      "types": "./lib/with-page-config.ts",
      "default": "./dist/lib/with-page-config.js"
    }
  },
  "scripts": {
    "clean:node_modules": "pnpx rimraf node_modules",
    "clean:bundle": "pnpx rimraf dist",
    "clean": "pnpm clean:bundle && pnpm clean:node_modules",
    "ready": "tsc -b"
  },
  "dependencies": {
    "@extension/env": "workspace:*"
  },
  "devDependencies": {
    "@extension/hmr": "workspace:*",
    "@extension/tsconfig": "workspace:*",
    "@vitejs/plugin-react-swc": "^4.2.2"
  }
}
