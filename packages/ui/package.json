{
  "name": "@extension/ui",
  "version": "0.0.0",
  "description": "chrome extension - ui components",
  "type": "module",
  "private": true,
  "sideEffects": [
    "*.css",
    "base.css"
  ],
  "files": [
    "dist/**",
    "base.css"
  ],
  "exports": {
    "./*": {
      "types": [
        "./lib/*.ts",
        "./lib/*.tsx"
      ],
      "default": "./dist/lib/*.js"
    },
    "./base.css": "./base.css"
  },
  "scripts": {
    "clean:bundle": "rimraf dist",
    "clean:node_modules": "pnpx rimraf node_modules",
    "clean:turbo": "rimraf .turbo",
    "clean": "pnpm clean:bundle && pnpm clean:node_modules && pnpm clean:turbo",
    "ready": "tsc -b && tsc-alias -p tsconfig.json",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@extension/core": "workspace:*",
    "@extension/i18n": "workspace:*",
    "@extension/shared": "workspace:*",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "emojibase-data": "^18.0.0",
    "lucide-react": "^1.63.0",
    "react-spinners": "^0.17.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@extension/tsconfig": "workspace:*",
    "tsc-alias": "^1.9.9"
  }
}
