{
  "name": "@extension/hmr",
  "version": "0.0.0",
  "description": "chrome extension - hot module reload/refresh",
  "type": "module",
  "private": true,
  "sideEffects": true,
  "files": [
    "dist/**"
  ],
  "exports": {
    "./make-entry-point-plugin": {
      "types": "./lib/plugins/make-entry-point-plugin.ts",
      "default": "./dist/lib/plugins/make-entry-point-plugin.js"
    },
    "./watch-public-plugin": {
      "types": "./lib/plugins/watch-public-plugin.ts",
      "default": "./dist/lib/plugins/watch-public-plugin.js"
    },
    "./watch-rebuild-plugin": {
      "types": "./lib/plugins/watch-rebuild-plugin.ts",
      "default": "./dist/lib/plugins/watch-rebuild-plugin.js"
    }
  },
  "scripts": {
    "clean:bundle": "rimraf dist && pnpx rimraf build",
    "clean:node_modules": "pnpx rimraf node_modules",
    "clean:turbo": "rimraf .turbo",
    "clean": "pnpm clean:bundle && pnpm clean:node_modules && pnpm clean:turbo",
    "ready": "tsc -b && rollup --config dist/rollup.config.js",
    "dev": "tsx lib/initializers/init-reload-server.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@extension/env": "workspace:*",
    "@extension/tsconfig": "workspace:*",
    "@rollup/plugin-sucrase": "^5.0.2",
    "@types/ws": "^8.18.1",
    "esm": "^3.2.25",
    "rollup": "^4.53.3",
    "ws": "^8.18.3"
  }
}
