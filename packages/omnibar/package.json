{
  "name": "@extension/omnibar",
  "version": "0.0.0",
  "description": "Omnibar shared business logic",
  "type": "module",
  "private": true,
  "sideEffects": true,
  "files": [
    "dist/**"
  ],
  "exports": {
    "./executeOmnibarUrl": {
      "types": "./lib/executeOmnibarUrl.ts",
      "default": "./dist/lib/executeOmnibarUrl.js"
    },
    "./omnibarResultGenerators": {
      "types": "./lib/omnibarResultGenerators.ts",
      "default": "./dist/lib/omnibarResultGenerators.js"
    },
    "./searchBookmarks": {
      "types": "./lib/searchBookmarks.ts",
      "default": "./dist/lib/searchBookmarks.js"
    },
    "./searchClosedTabs": {
      "types": "./lib/searchClosedTabs.ts",
      "default": "./dist/lib/searchClosedTabs.js"
    },
    "./searchHistory": {
      "types": "./lib/searchHistory.ts",
      "default": "./dist/lib/searchHistory.js"
    },
    "./useOmnibarExternalSearch": {
      "types": "./lib/useOmnibarExternalSearch.ts",
      "default": "./dist/lib/useOmnibarExternalSearch.js"
    },
    "./useOmnibarGenerators": {
      "types": "./lib/useOmnibarGenerators.ts",
      "default": "./dist/lib/useOmnibarGenerators.js"
    },
    "./useOmnibarTabs": {
      "types": "./lib/useOmnibarTabs.ts",
      "default": "./dist/lib/useOmnibarTabs.js"
    },
    "./WiredOmnibar": {
      "types": "./lib/WiredOmnibar.tsx",
      "default": "./dist/lib/WiredOmnibar.js"
    },
    "./omnibar-tailwind-config": {
      "types": "./lib/omnibar-tailwind-config.ts",
      "default": "./dist/lib/omnibar-tailwind-config.js"
    }
  },
  "scripts": {
    "clean:bundle": "rimraf dist",
    "clean:node_modules": "pnpx rimraf node_modules",
    "clean:turbo": "rimraf .turbo",
    "clean": "pnpm clean:bundle && pnpm clean:node_modules && pnpm clean:turbo",
    "ready": "tsc -b",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@extension/chrome": "workspace:*",
    "@extension/ui": "workspace:*"
  },
  "devDependencies": {
    "@extension/tsconfig": "workspace:*"
  }
}
