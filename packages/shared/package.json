{
  "name": "@extension/shared",
  "version": "0.0.0",
  "description": "chrome extension - shared code",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "exports": {
    "./hoc/with-error-boundary": {
      "types": "./lib/hoc/with-error-boundary.tsx",
      "default": "./dist/lib/hoc/with-error-boundary.js"
    },
    "./hoc/with-suspense": {
      "types": "./lib/hoc/with-suspense.tsx",
      "default": "./dist/lib/hoc/with-suspense.js"
    },
    "./hooks/preference": {
      "types": "./lib/hooks/preference.ts",
      "default": "./dist/lib/hooks/preference.js"
    },
    "./hooks/use-storage": {
      "types": "./lib/hooks/use-storage.tsx",
      "default": "./dist/lib/hooks/use-storage.js"
    },
    "./utils/colorful-logger": {
      "types": "./lib/utils/colorful-logger.ts",
      "default": "./dist/lib/utils/colorful-logger.js"
    },
    "./utils/const": {
      "types": "./lib/utils/const.ts",
      "default": "./dist/lib/utils/const.js"
    },
    "./utils/helpers": {
      "types": "./lib/utils/helpers.ts",
      "default": "./dist/lib/utils/helpers.js"
    },
    "./utils/platform": {
      "types": "./lib/utils/platform.ts",
      "default": "./dist/lib/utils/platform.js"
    },
    "./utils/types": {
      "types": "./lib/utils/types.ts",
      "default": "./dist/lib/utils/types.js"
    }
  },
  "scripts": {
    "clean:bundle": "rimraf dist",
    "clean:node_modules": "pnpx rimraf node_modules",
    "clean:turbo": "rimraf .turbo",
    "clean": "pnpm clean:bundle && pnpm clean:node_modules && pnpm clean:turbo",
    "ready": "tsc -b",
    "type-check": "tsc --noEmit",
    "postinstall": "pnpm ready"
  },
  "dependencies": {
    "react-error-boundary": "^6.0.0"
  },
  "devDependencies": {
    "@extension/storage": "workspace:*",
    "@extension/tsconfig": "workspace:*",
    "type-fest": "^5.3.0"
  }
}
