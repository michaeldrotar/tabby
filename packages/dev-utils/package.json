{
  "name": "@extension/dev-utils",
  "version": "0.0.0",
  "description": "chrome extension - dev utils",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "exports": {
    "./ManifestParser": {
      "types": "./lib/manifest-parser/impl.ts",
      "default": "./dist/lib/manifest-parser/impl.js"
    },
    "./stream-file-to-zip": {
      "types": "./lib/stream-file-to-zip.ts",
      "default": "./dist/lib/stream-file-to-zip.js"
    }
  },
  "scripts": {
    "clean:bundle": "rimraf dist",
    "clean:node_modules": "pnpx rimraf node_modules",
    "clean:turbo": "rimraf .turbo",
    "clean": "pnpm clean:bundle && pnpm clean:node_modules && pnpm clean:turbo",
    "ready": "tsc -b",
    "type-check": "tsc --noEmit",
    "postinstall": "pnpm ready"
  },
  "devDependencies": {
    "@extension/tsconfig": "workspace:*",
    "@extension/shared": "workspace:*"
  }
}
